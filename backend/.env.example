# Copy to .env and fill these values before starting the backend.
MONGO_URI=mongodb+srv://db_user:replace_me@your-cluster.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET_KEY=replace_with_a_long_private_random_value
PORT=5000
ADMIN_LOGIN_ID=ADMIN001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_before_first_run
